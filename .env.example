# ===== AAPay Docker 配置（复制为 .env）=====

# 运行模式：isolated = 多账本 + 口令加入（默认）；shared = 单一公共账本，打开即用，无管理后台
MODE=isolated

# 管理员认证方式：
#   access   — 放在 Cloudflare Tunnel + Access 之后，校验 Access JWT（推荐）
#   password — 内置密码登录
#   proxy    — 信任上游反向代理（oauth2-proxy / Authelia / Traefik ForwardAuth）传入的身份头
#   none     — 不校验（仅限本地开发！）
#   disabled — 关闭管理后台（默认）
ADMIN_AUTH=password

# ADMIN_AUTH=password
ADMIN_PASSWORD=change-me-please

# ADMIN_AUTH=access
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=

# ADMIN_AUTH=proxy
# ADMIN_EMAIL_HEADER=X-Forwarded-Email

# access / proxy 模式下的管理员邮箱白名单（逗号分隔，可选）
# ADMIN_EMAILS=you@example.com

# 连接 AI（MCP + OAuth 2.1）：enabled（默认）| disabled
# MCP=enabled
# 对外访问地址，作为 OAuth issuer 与 MCP 资源标识；放在反向代理 / Tunnel 后面时建议填写
# PUBLIC_URL=https://aapay.example.com
# AI 记账未指定日期时使用的时区
# TIMEZONE=Asia/Shanghai

# 操作动态的 Ed25519 签名私钥（32 字节 base64url），设置后不要更换
# 生成：node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# AUDIT_SIGNING_KEY=

# AI 助手（对话记账、查账、识别账单图片）：enabled（默认）| disabled
# ASSISTANT=enabled
# 站点提供的 Gemini API 密钥；不填时用户需在 AI 助手设置里填自己的 Key
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# 宿主机端口（docker compose 使用）
AAPAY_PORT=8787
