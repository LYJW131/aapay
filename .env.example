# AAPay 的 Docker / Node 配置：复制为 .env，按需取消注释并填写。
# 全部变量见 README「配置」一节。

# 运行模式：isolated = 多账本 + 口令加入（默认）；shared = 单一公共账本，打开即用，无管理后台
# MODE=isolated

# 管理员认证方式（默认 disabled，即关闭管理后台；isolated 模式下需要开启才能创建账本）：
#   password — 内置密码登录
#   access   — 放在 Cloudflare Tunnel + Access 之后，校验 Access JWT
#   proxy    — 信任上游反向代理（oauth2-proxy / Authelia / Traefik ForwardAuth）传入的身份头
#   none     — 不校验（仅限本地开发！）
# ADMIN_AUTH=password

# ADMIN_AUTH=password 时的管理员密码（至少 8 位）
ADMIN_PASSWORD=

# ADMIN_AUTH=access
# ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# ACCESS_AUD=

# ADMIN_AUTH=proxy
# ADMIN_EMAIL_HEADER=X-Forwarded-Email

# access / proxy 模式下的管理员邮箱白名单（逗号分隔，可选）
# ADMIN_EMAILS=you@example.com

# 连接 AI（MCP + OAuth 2.1）：enabled（默认）| disabled
# MCP=enabled
# 对外访问地址，作为 OAuth issuer 与 MCP 资源标识；放在反向代理 / Tunnel 后面时建议填写
# PUBLIC_URL=https://aapay.example.com
# 放在反向代理后面时开启：按 X-Forwarded-For 最后一项识别客户端 IP，用于登录与加入限流
# TRUST_PROXY=enabled
# AI 记账未指定日期时使用的时区
# TIMEZONE=Asia/Shanghai

# 操作动态的 Ed25519 签名私钥（32 字节 base64url），设置后不要更换
# 生成：node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# AUDIT_SIGNING_KEY=

# AI 助手（对话记账、查账、识别账单图片）：enabled（默认）| disabled
# ASSISTANT=enabled
# 站点使用的服务商：gemini（默认）| deepseek；该服务商没配 Key 时，用户需在 AI 助手设置里填自己的 Key
# ASSISTANT_PROVIDER=gemini   # gemini | deepseek | claude | openai（OpenAI 兼容，需 OPENAI_BASE_URL 与 OPENAI_MODEL）
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# 宿主机端口（docker compose 使用）
# AAPAY_PORT=8787
